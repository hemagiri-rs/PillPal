# Shared local environment for PillPal. Copy to .env and replace every CHANGE_ME value.

# ---- Backend (server-side values; never expose these in PUBLIC_* variables) ----
DATABASE_URL=postgresql://postgres:CHANGE_ME@aws-0-region.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=CHANGE_ME_SUPABASE_SERVICE_ROLE_KEY
CORS_ORIGINS=["http://localhost:4321"]
GROQ_API_KEY=CHANGE_ME_GROQ_API_KEY
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Frontend (PUBLIC_* values are bundled into the browser) ----
PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=CHANGE_ME_SUPABASE_PUBLISHABLE_KEY
PUBLIC_API_URL=http://localhost:8000