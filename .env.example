# Shared env for PillPal. Copy to .env (git-ignored) and fill in.

# ---- Backend (secret: never PUBLIC_) ----
# Supabase: Dashboard -> Connect -> Session pooler. Write "@" in the password as %40.
# Not the direct db.<ref>.supabase.co host: it is IPv6-only and fails DNS on IPv4-only networks.
DATABASE_URL=postgresql://postgres.vxgbzjjdkiuzczafyvad:<password>@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres
SUPABASE_URL=https://vxgbzjjdkiuzczafyvad.supabase.co
# Project Settings -> API Keys -> Secret keys (sb_secret_...). This IS the "service role" key.
SUPABASE_SERVICE_ROLE_KEY=sb_secret_...
CORS_ORIGINS=["http://localhost:4321"]
# console.groq.com -> API Keys
GROQ_API_KEY=gsk_...
GROQ_MODEL=qwen/qwen3.8-27b

# ---- Frontend (PUBLIC_* are sent to the browser: public values only) ----
PUBLIC_SUPABASE_URL=https://vxgbzjjdkiuzczafyvad.supabase.co
# Project Settings -> API Keys -> Publishable key (sb_publishable_...)
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
PUBLIC_API_URL=http://localhost:8000
