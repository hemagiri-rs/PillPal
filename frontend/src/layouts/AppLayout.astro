---
import "@fontsource/atkinson-hyperlegible/400.css";
import "@fontsource/atkinson-hyperlegible/700.css";
import "@fontsource/lora/600.css";
import "../styles/global.css";
import NavBar from "../components/NavBar";

interface Props {
  title: string;
  /** Pages behind login show the navigation; the login page does not. */
  nav?: "today" | "medicines" | "progress" | "invitations" | "family" | false;
}
const { title, nav = false } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#24532f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-capable" content="yes" />
    <meta name="apple-mobile-web-app-title" content="PillPal" />
    <title>{title} · PillPal</title>
    <script is:inline>
      // Before first paint: saved text size, language and direction (avoids a jump / flash)
      try {
        const size = localStorage.getItem("pillpal:text-size");
        if (size) document.documentElement.dataset.textSize = size;
        const lang = localStorage.getItem("pillpal:lang");
        if (lang) document.documentElement.lang = lang;
        document.documentElement.dir = localStorage.getItem("pillpal:dir") || "ltr";
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main" data-i18n>Skip to main content</a>
    {nav !== false && <NavBar client:only="preact" active={nav} />}
    <main id="main" class={nav !== false ? "app-main" : "plain-main"}>
      <slot />
    </main>
    <footer class="disclaimer">
      <span data-i18n
        >PillPal is for reminders only. It is not medical advice. Always follow your doctor's or
        pharmacist's instructions.</span
      >
    </footer>
    <script>
      import { hasChosenLang, translateStatic } from "../lib/i18n";

      // Installable app (PWA) + reminder notifications both use the service worker.
      if ("serviceWorker" in navigator) navigator.serviceWorker.register("/sw.js").catch(() => {});

      // First visit: choose a language before anything else.
      if (!hasChosenLang() && location.pathname !== "/language") location.href = "/language";
      translateStatic();
    </script>
  </body>
</html>

<style>
  .skip-link {
    position: absolute;
    left: -999px;
    top: 0.5rem;
    background: var(--primary);
    color: #fff;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    z-index: 10;
  }
  .skip-link:focus {
    left: 0.5rem;
  }
  main {
    max-width: var(--content);
    margin: 0 auto;
    padding: var(--space-4) var(--space-3);
    padding-left: max(var(--space-3), env(safe-area-inset-left));
    padding-right: max(var(--space-3), env(safe-area-inset-right));
  }
  /* room for the bottom tab bar on phones */
  .app-main {
    padding-bottom: calc(6.5rem + env(safe-area-inset-bottom));
  }
  @media (min-width: 60rem) {
    .app-main {
      padding-bottom: var(--space-5);
    }
  }
  .disclaimer {
    max-width: var(--content);
    margin: 0 auto calc(6.5rem + env(safe-area-inset-bottom));
    padding: 0 var(--space-3) var(--space-4);
    color: var(--text-muted);
    font-size: var(--fs-sm);
    text-align: center;
  }
  @media (min-width: 60rem) {
    .disclaimer {
      margin-bottom: var(--space-4);
    }
  }
</style>
