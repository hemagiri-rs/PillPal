# Copy to .env and fill in. Never commit .env.
# Local dev can keep SQLite; for the demo use the Supabase Postgres connection string
# (Dashboard -> Connect -> Session pooler), e.g.
# DATABASE_URL=postgresql+psycopg://postgres.edigxaukkpxvgrykxanf:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
DATABASE_URL=sqlite:///./pillpal.db
SUPABASE_URL=https://edigxaukkpxvgrykxanf.supabase.co
# Secret key, used only by the seed script to create demo login users
SUPABASE_SERVICE_ROLE_KEY=
CORS_ORIGINS=["http://localhost:4321"]
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
